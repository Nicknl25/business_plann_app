+def _canonicalize_person_row(row: Any) -> Tuple[Any, bool]:
+  """Map the router's raw people-row shape onto the contract's keys. Returns
+  (row, aliased) - aliased is True when the row carried ANY raw-shape key
+  (it came through the unenforced router path). A canonical value already
+  present and non-empty is never overwritten by its alias; the alias keys
+  are removed after mapping; wage_source 'client_provided' becomes
+  'client_override' (the contract's vocabulary for a client-stated wage),
+  and a client-stated annual_pay with no wage_source at all is stamped
+  client_override (the extractor door's own rule). experience_years is
+  typed str by the contract, so a numeric years_experience is stringified.
+  Non-dict rows pass through untouched (aliased=False)."""
+  if not isinstance(row, dict):
+    return row, False
+  has_alias_key = any(k in row for k in _PERSON_ROW_ALIAS_KEYS)
+  if (not has_alias_key
+      and str(row.get("wage_source") or "").strip().lower() != "client_provided"):
+    return row, False
+  out = dict(row)
+
+  def _empty(v: Any) -> bool:
+    return v is None or (isinstance(v, str) and not v.strip())
+
+  pay_aliased = False
+  for raw_key, canon_key in _PERSON_ROW_ALIASES:
+    if raw_key not in out:
+      continue
+    raw_val = out.pop(raw_key)
+    if _empty(raw_val) or not _empty(out.get(canon_key)):
+      continue
