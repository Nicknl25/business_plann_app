{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "app_agents/capital_agent_output.schema.json",
  "title": "Capital Agent Output",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "agent_name": { "type": "string", "const": "capital_agent" },
    "summary": { "type": "string" },
    "detailed_reasoning_memo": { "type": "string" },
    "critical_assumptions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "capital_read": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cash_strategy_summary": { "type": "string" },
        "liquidity_buffer_summary": { "type": "string" },
        "excess_cash_summary": { "type": "string" },
        "deployment_summary": { "type": "string" }
      },
      "required": ["cash_strategy_summary", "liquidity_buffer_summary", "excess_cash_summary", "deployment_summary"]
    },
    "strategy_signature": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "selected_strategy": { "type": "string" },
        "liquidity_posture": { "type": "string" },
        "cash_shape_rule": { "type": "string" },
        "cash_monotonicity_expectation": { "type": "string" },
        "primary_deployment_rows": {
          "type": "array",
          "items": { "type": "string" }
        },
        "secondary_deployment_rows": {
          "type": "array",
          "items": { "type": "string" }
        },
        "protected_rows": {
          "type": "array",
          "items": { "type": "string" }
        },
        "forbidden_patterns": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": [
        "selected_strategy",
        "liquidity_posture",
        "cash_shape_rule",
        "cash_monotonicity_expectation",
        "primary_deployment_rows",
        "secondary_deployment_rows",
        "protected_rows",
        "forbidden_patterns"
      ]
    },
    "capital_phases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "phase_id": { "type": "string" },
          "quarter_start": { "type": "integer", "minimum": 1, "maximum": 20 },
          "quarter_end": { "type": "integer", "minimum": 1, "maximum": 20 },
          "cash_posture": { "type": "string" },
          "deployment_priority_rows": {
            "type": "array",
            "items": { "type": "string" }
          },
          "financing_posture": { "type": "string" },
          "explanation": { "type": "string" }
        },
        "required": [
          "phase_id",
          "quarter_start",
          "quarter_end",
          "cash_posture",
          "deployment_priority_rows",
          "financing_posture",
          "explanation"
        ]
      }
    },
    "constraints": {
      "type": "array",
      "items": { "$ref": "#/$defs/constraint" }
    },
    "vetoes": {
      "type": "array",
      "items": { "$ref": "#/$defs/veto" }
    },
    "strategy_visibility_requirements": {
      "type": "array",
      "items": { "type": "string" }
    },
    "row_implications": {
      "type": "array",
      "items": { "$ref": "#/$defs/rowImplication" }
    },
    "quarter_implications": {
      "type": "array",
      "items": { "$ref": "#/$defs/quarterImplication" }
    },
    "must_change_rows": {
      "type": "array",
      "items": { "$ref": "#/$defs/revisionRequest" }
    },
    "draft_review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "review_mode_used": { "type": "boolean" },
        "overall_assessment": { "type": "string" },
        "passes": { "type": "array", "items": { "type": "string" } },
        "failures": { "type": "array", "items": { "type": "string" } },
        "required_revisions": {
          "type": "array",
          "items": { "$ref": "#/$defs/revisionRequest" }
        }
      },
      "required": ["review_mode_used", "overall_assessment", "passes", "failures", "required_revisions"]
    }
  },
  "required": [
    "agent_name",
    "summary",
    "detailed_reasoning_memo",
    "critical_assumptions",
    "capital_read",
    "strategy_signature",
    "capital_phases",
    "constraints",
    "vetoes",
    "strategy_visibility_requirements",
    "row_implications",
    "quarter_implications",
    "must_change_rows",
    "draft_review"
  ],
  "$defs": {
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "constraint_id": { "type": "string" },
        "binding_level": { "type": "string", "enum": ["binding", "strong", "guidance"] },
        "description": { "type": "string" },
        "affected_rows": { "type": "array", "items": { "type": "string" } },
        "rationale": { "type": "string" }
      },
      "required": ["constraint_id", "binding_level", "description", "affected_rows", "rationale"]
    },
    "veto": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "veto_id": { "type": "string" },
        "description": { "type": "string" },
        "blocking_reason": { "type": "string" }
      },
      "required": ["veto_id", "description", "blocking_reason"]
    },
    "rowImplication": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "row_id": { "type": "string" },
        "expectation": { "type": "string" },
        "magnitude_guidance": { "type": "string" },
        "strategy_link": { "type": "string" },
        "rationale": { "type": "string" }
      },
      "required": ["row_id", "expectation", "magnitude_guidance", "strategy_link", "rationale"]
    },
    "quarterImplication": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "quarter_start": { "type": "integer", "minimum": 1, "maximum": 20 },
        "quarter_end": { "type": "integer", "minimum": 1, "maximum": 20 },
        "expectation": { "type": "string" },
        "cash_posture": { "type": "string" },
        "rationale": { "type": "string" }
      },
      "required": ["quarter_start", "quarter_end", "expectation", "cash_posture", "rationale"]
    },
    "revisionRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "row_id": { "type": "string" },
        "required_change": { "type": "string" },
        "urgency": { "type": "string", "enum": ["high", "medium", "low"] },
        "business_reason": { "type": "string" }
      },
      "required": ["row_id", "required_change", "urgency", "business_reason"]
    }
  }
}
